# Rwandan Skill-Games Platform Environment Configuration
# Reference: Rwandan Skill-Games Platform Concept Document Section 6, 9 & 10

# Launch Phase Mode: "free" (default: all features, inka tokens, and games are 100% free)
VITE_LAUNCH_PHASE="free"

# Real-money features are disabled by default until full regulatory and KYC compliance
VITE_ENABLE_REAL_MONEY="false"

# APP_URL: Host application URL
APP_URL="https://example.com"
